#cloud-config
package_update: true
packages:
  - git
  - curl
  - software-properties-common
  - build-essential

write_files:
  - path: /usr/local/bin/mlfd-bootstrap-base.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      export DEBIAN_FRONTEND=noninteractive

      if ! command -v python3.12 >/dev/null 2>&1; then
        add-apt-repository -y ppa:deadsnakes/ppa
        apt-get update
        apt-get install -y python3.12 python3.12-venv python3.12-dev
      fi

      if [ ! -d "__REPO_DIR__/.git" ]; then
        sudo -u __ADMIN_USERNAME__ git clone --branch __BRANCH__ --single-branch __REPO_URL__ __REPO_DIR__
      fi

      chown -R __ADMIN_USERNAME__:__ADMIN_USERNAME__ __REPO_DIR__

runcmd:
  - /usr/local/bin/mlfd-bootstrap-base.sh
